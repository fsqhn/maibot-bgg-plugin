{
  "manifest_version": 2,
  "name": "桌游搜索插件 (bgg_search_plugin)",
  "version": "0.0.8",
  "description": "利用集石、DDGS 和 LLM 查询桌游英文名，然后从 BGG 网站获取游戏的相关基本信息",
  "author": {
    "name": "山上的小丘",
    "url": "https://github.com/fsqhn"
  },
  "license": "GPL-v3.0-or-later",

  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },

  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },

  "dependencies": [
    { "type": "python_package", "name": "httpx", "version_spec": ">=0.26.0" },
    { "type": "python_package", "name": "beautifulsoup4", "version_spec": ">=4.12" },
    { "type": "python_package", "name": "ddgs", "version_spec": ">=0.1.0" }
  ],

  "capabilities": [
    "llm.generate",
    "send.text",
    "send.image"
  ],

  "plugin_type": "tool",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },

  "urls": {
    "repository": "https://github.com/fsqhn/maibot-bgg-plugin",
    "homepage": "https://github.com/fsqhn/maibot-bgg-plugin"
  },

  "id": "fsqhn.bgg_search_plugin"
}
